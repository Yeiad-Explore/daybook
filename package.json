{
  "name": "daybook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm check:tokens",
    "check:task": "pnpm check:fast && pnpm test && pnpm test:db && pnpm test:e2e",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "seed": "node scripts/seed.mjs",
    "functions:e2e": "supabase functions serve --env-file supabase/functions/e2e.env.example",
    "db:types": "supabase gen types --local --lang typescript --schema public > src/lib/database.types.ts",
    "tokens": "node scripts/gen-tokens.mjs",
    "check:no-dev-routes": "node scripts/check-no-dev-routes.mjs",
    "check:all": "pnpm check:fast && pnpm test && pnpm test:db && pnpm build && pnpm check:no-dev-routes && pnpm audit --audit-level high && pnpm test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "cmdk": "^1.1.1",
    "d3-scale": "^4.0.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  }
}
