# Used by `pnpm functions:e2e` (supabase functions serve) together with e2e/fake-google/server.mjs.
# Everything here is fake: no real Google credentials belong in this file.
GOOGLE_CLIENT_ID=fake-client-id
GOOGLE_CLIENT_SECRET=fake-client-secret
GOOGLE_TOKEN_URL=http://host.docker.internal:4010/token
GOOGLE_REVOKE_URL=http://host.docker.internal:4010/revoke
GOOGLE_TOKENINFO_URL=http://host.docker.internal:4010/tokeninfo
GOOGLE_API_BASE=http://host.docker.internal:4010
APP_URL=http://localhost:3000
