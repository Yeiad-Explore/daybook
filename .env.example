# Copy to .env.local (gitignored) and fill in. Never commit real values.

# App -> Supabase. Local stack: values from `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth client (T14). Read by supabase/config.toml for the local stack only.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Edge Function secrets (Phase 3) do NOT go in this file. Locally they live in supabase/functions/.env (gitignored):
#   GOOGLE_CLIENT_ID=...      the SAME OAuth client Supabase uses for Google sign-in
#   GOOGLE_CLIENT_SECRET=...
#   APP_URL=http://localhost:3000
# On the cloud project: supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... APP_URL=https://<your domain>

# Cloud project (not used by the app in Phase 0).
SUPABASE_CLOUD_PROJECT_REF=
SUPABASE_CLOUD_URL=
SUPABASE_CLOUD_DB_PASSWORD=
SUPABASE_CLOUD_PUBLISHABLE_KEY=
SUPABASE_CLOUD_SECRET_KEY=
SUPABASE_CLOUD_ANON_KEY=
SUPABASE_CLOUD_SERVICE_ROLE_KEY=
